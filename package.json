{
  "name": "forkguard",
  "version": "0.9.2",
  "description": "Catch malware hidden in a repo before you install or run it, clean it up, open a pull request, check this computer, and check AI agent skills before you install them.",
  "type": "module",
  "bin": {
    "forkguard": "bin/forkguard.js"
  },
  "exports": {
    "./core": "./src/core.js",
    "./clean": "./src/clean.js",
    "./skills": "./src/skills/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "scan": "node bin/forkguard.js",
    "docs": "node tools/build-docs.mjs"
  },
  "keywords": [
    "security",
    "malware",
    "supply-chain",
    "npm",
    "git",
    "github",
    "polinrider",
    "cli",
    "agent-skills",
    "claude-code",
    "skills",
    "prompt-injection",
    "skillspector"
  ],
  "author": "Prodhosh V.S",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PRODHOSH/forkguard.git"
  },
  "homepage": "https://forkguard.pages.dev",
  "bugs": {
    "url": "https://github.com/PRODHOSH/forkguard/issues"
  }
}
